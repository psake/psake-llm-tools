{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "psake-tools",
  "owner": {
    "name": "psake",
    "email": "team@psake.dev"
  },
  "metadata": {
    "description": "Claude skills for the psake PowerShell build automation ecosystem",
    "version": "2.0.0",
    "pluginRoot": "./plugins"
  },
  "plugins": [
    {
      "name": "psake",
      "source": "./psake",
      "description": "psake PowerShell build automation — task-based build scripts for .NET, Node.js, Docker, and more",
      "version": "1.0.0",
      "author": {
        "name": "psake",
        "email": "team@psake.dev"
      },
      "homepage": "https://psake.dev",
      "repository": "https://github.com/psake/psake-llm-tools",
      "license": "MIT",
      "keywords": ["psake", "powershell", "build", "automation"],
      "tags": ["psake", "powershell", "build", "automation"],
      "category": "developer-tools"
    },
    {
      "name": "powershellbuild",
      "source": "./plugins/powershellbuild",
      "description": "PowerShellBuild — standardized build, test, and publish tasks for PowerShell module development",
      "version": "1.0.0",
      "author": {
        "name": "psake",
        "email": "team@psake.dev"
      },
      "homepage": "https://github.com/psake/PowerShellBuild",
      "repository": "https://github.com/psake/psake-llm-tools",
      "license": "MIT",
      "keywords": ["powershellbuild", "powershell", "module", "pester", "psscriptanalyzer"],
      "tags": ["powershellbuild", "powershell", "module", "pester", "psscriptanalyzer"],
      "category": "developer-tools"
    }
  ]
}
